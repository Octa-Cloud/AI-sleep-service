def get_period_avg(conn, cursor, user_id: int, start_date: date, end_date: date) -> Dict[str, Optional[Any]]:
    """DB에서 기간별 일일 보고서 데이터와 bed_at 평균을 가져와 계산합니다."""
    
    # 1. daily_report에서 점수, 수면 시간, 비율 데이터를 가져옵니다.
    cursor.execute("""
    SELECT score, total_sleep_minutes, deep_ratio, light_ratio, rem_ratio 
    FROM daily_report
    WHERE user_id=%s AND sleep_date BETWEEN %s AND %s
    ORDER BY sleep_date ASC
    """, (user_id, start_date, end_date))
    rows = cursor.fetchall()
    
    if not rows:
        raise ValueError(f"사용자 {user_id}의 {start_date}부터 {end_date}까지의 데이터가 없습니다.")
        
    # 2. sleep_session에서 bed_at 취침 시간을 가져옵니다.
    cursor.execute("""
    SELECT bed_at 
    FROM sleep_session
    WHERE user_id=%s AND DATE(bed_at) BETWEEN %s AND %s
    """, (user_id, start_date, end_date))
    sleep_rows = cursor.fetchall()
    
    # 컬럼명을 'bed_at'으로 사용
    bed_times = [r.get('bed_at') for r in sleep_rows if r.get('bed_at') is not None]
    avg_bed_time = calculate_average_time(bed_times)

    return {
        "avg_score": cumulative_average([r.get('score') for r in rows]),
        "avg_sleep_minutes": cumulative_average([r.get('total_sleep_minutes') for r in rows]),
        "deep_ratio": cumulative_average([r.get('deep_ratio') for r in rows]),
        "light_ratio": cumulative_average([r.get('light_ratio') for r in rows]),
        "rem_ratio": cumulative_average([r.get('rem_ratio') for r in rows]),
        "avg_bed_time": avg_bed_time
    }

def clean_non_standard_json(text: str) -> str:
    """Agent가 반환한 비표준 JSON (키에 따옴표 없는 경우)을 보강된 정규식으로 교정합니다."""
    text = text.replace("```json", "").replace("```", "").strip()
    
    # 키에 따옴표 없는 JSON을 처리하는 정규식:
    text = re.sub(r'([\{\,]\s*)(\s*\w+\s*)(\s*:\s*)', r'\1"\2"\3', text)
    
    # 불완전한 쉼표 제거 (오류 방지)
    text = text.replace(',\n}', '\n}')
    
    return text

def parse_agent_response(output_text: str) -> Optional[Tuple[Dict[str, Any], Dict[str, Any]]]:
    """Agent 응답 텍스트를 클리닝하고 2개의 JSON 블록을 파싱합니다."""
    
    # Agent가 불필요한 텍스트를 추가했을 경우를 대비하여 JSON 객체({})만 강제 추출
    json_pattern = r'(\{.*?\})' 
    json_blocks = re.findall(json_pattern, output_text, re.DOTALL)
    
    if len(json_blocks) < 2:
        print(f"🚨 Agent 응답에서 2개의 JSON 블록을 찾지 못했습니다. (추출된 블록 수: {len(json_blocks)})")
        return None
        
    try:
        # 첫 번째 블록과 두 번째 블록을 개별적으로 클리닝 후 파싱
        daily_report_json_raw = clean_non_standard_json(json_blocks[0])
        analysis_json_raw = clean_non_standard_json(json_blocks[1])
        
        daily_report_json = json.loads(daily_report_json_raw)
        analysis_json = json.loads(analysis_json_raw)
        
        print("✅ JSON 2개 블록 파싱 성공.")
        return daily_report_json, analysis_json
        
    except json.JSONDecodeError as e:
        print(f"🚨 JSON 파싱 오류 (강제 교정 및 추출 후에도 실패): {e}")
        # 오류 발생 블록이 어떤 내용인지 확인
        print(f"   (B1 교정 시도 텍스트: '{daily_report_json_raw[:50]}...')")
        print(f"   (B2 교정 시도 텍스트: '{analysis_json_raw[:50]}...')")
        return None

def update_periodic_report_db(conn, cursor, user_id: int, start_date: date, end_date: date, daily_report_json: Dict[str, Any], analysis_json: Dict[str, Any], period_avg: Dict[str, Any]):
    period_length = (end_date - start_date).days + 1
    if period_length >= 28:
        report_type = 'monthly'
    else:
        report_type = 'weekly' 
        
    avg_bed_time = period_avg.get('avg_bed_time')
    
    upsert_sql = """
    INSERT INTO periodic_report (
        user_id, period_start_date, period_end_date, report_type, 
        avg_score, avg_sleep_minutes, avg_bed_time, deep_ratio, light_ratio, rem_ratio,
        improvement, weakness, recommendation
    ) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    ON DUPLICATE KEY UPDATE
        report_type=VALUES(report_type),
        avg_score=VALUES(avg_score),
        avg_sleep_minutes=VALUES(avg_sleep_minutes),
        avg_bed_time=VALUES(avg_bed_time),
        deep_ratio=VALUES(deep_ratio),
        light_ratio=VALUES(light_ratio),
        rem_ratio=VALUES(rem_ratio),
        improvement=VALUES(improvement),
        weakness=VALUES(weakness),
        recommendation=VALUES(recommendation);
    """
    
    params = (
        user_id, start_date, end_date, report_type,
        daily_report_json.get('score', period_avg['avg_score']),
        daily_report_json.get('total_sleep_minutes', period_avg['avg_sleep_minutes']),
        avg_bed_time,
        daily_report_json.get('deep_ratio', period_avg['deep_ratio']),
        daily_report_json.get('light_ratio', period_avg['light_ratio']),
        daily_report_json.get('rem_ratio', period_avg['rem_ratio']),
        analysis_json.get('improvement', ''),
        analysis_json.get('weakness', ''),
        analysis_json.get('recommendation', '')
    )
    
    cursor.execute(upsert_sql, params)
    conn.commit()
    print(f"✅ DB UPSERT 성공: user_id={user_id}, 기간: {start_date} ~ {end_date}, 타입: {report_type}")

