def cumulative_average(values: list) -> Optional[float]:
    """리스트의 누적 평균을 계산합니다."""
    valid_values = [float(v) for v in values if v is not None] 
    if not valid_values:
        return None

    cum_avg = []
    for i, v in enumerate(valid_values):
        if i == 0:
            cum_avg.append(v)
        else:
            prev_avg = cum_avg[-1]
            new_avg = (prev_avg * i + v) / (i + 1)
            cum_avg.append(new_avg)
    return cum_avg[-1]

def calculate_average_time(times: list) -> Optional[str]:
    """bed_at 시간 리스트를 기반으로 평균 시각을 HH:MM:SS 문자열로 계산합니다."""
    if not times:
        return None
    
    SECONDS_IN_DAY = 86400
    
    total_seconds = []
    
    for t in times:
        if isinstance(t, datetime):
            t = t.time()
        
        seconds = t.hour * 3600 + t.minute * 60 + t.second
        
        # 새벽 4시 이전 시간은 이전 날의 취침 시간으로 간주하여 24시간을 더해 평균을 정확히 계산합니다.
        if seconds < 4 * 3600:
            seconds += SECONDS_IN_DAY
        
        total_seconds.append(seconds)
            
    avg_seconds = sum(total_seconds) / len(total_seconds)
    
    # 결과를 24시간 주기로 정규화합니다.
    avg_seconds = avg_seconds % SECONDS_IN_DAY
    
    hours = int(avg_seconds // 3600)
    minutes = int((avg_seconds % 3600) // 60)
    seconds = int(avg_seconds % 60)
    
    return f"{hours:02}:{minutes:02}:{seconds:02}"

